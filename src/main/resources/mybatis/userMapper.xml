<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.web.mapper.UserMapper">
    <resultMap id="BaseResultMap" type="org.example.web.entity.User">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="nickname" property="nickname" />
        <result column="avatar" property="avatar" />
        <result column="gender" property="gender" />
        <result column="major" property="major" />
        <result column="grade" property="grade" />
        <result column="introduction" property="introduction" />
        <result column="phone" property="phone" />
        <result column="email" property="email" />
        <result column="qq" property="qq" />
        <result column="wechat" property="wechat" />
        <result column="address" property="address" />
        <result column="birthday" property="birthday" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>
    <!-- 按主键 id 查询用户 -->
    <select id="getById" parameterType="long" resultMap="BaseResultMap">
        select * from user where id = #{id}
    </select>
    <!-- 按学号（user.user_id）查询用户 -->
    <select id="getByUserId" parameterType="string" resultMap="BaseResultMap">
        select * from user where user_id = #{userId}
    </select>
    <!-- 按主键 id 查询（兼容历史方法名） -->
    <select id="getByuserId" parameterType="int" resultMap="BaseResultMap">
        select * from user where id = #{id}
    </select>

    <!-- 新增用户，回填自增 id -->
    <insert id="insert" parameterType="org.example.web.entity.User" useGeneratedKeys="true" keyProperty="id" >
        INSERT INTO user (
            user_id, nickname, avatar, gender, major, grade,
            introduction, phone, email, qq, wechat, address,
            birthday, created_at, updated_at
        ) VALUES (
                     #{userId}, #{nickname}, #{avatar}, #{gender}, #{major}, #{grade},
                     #{introduction}, #{phone}, #{email}, #{qq}, #{wechat}, #{address},
                     #{birthday}, #{createdAt}, #{updatedAt}
                 )
    </insert>
    <!-- 动态更新用户字段（含 user_id），自动刷新 updated_at -->
    <update id="update" parameterType="org.example.web.entity.User">
        UPDATE user
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="major != null">major = #{major},</if>
            <if test="grade != null">grade = #{grade},</if>
            <if test="introduction != null">introduction = #{introduction},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="qq != null">qq = #{qq},</if>
            <if test="wechat != null">wechat = #{wechat},</if>
            <if test="address != null">address = #{address},</if>
            <if test="birthday != null">birthday = #{birthday},</if>
            <if test="userId != null">user_id = #{userId},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <!-- 按主键物理删除用户 -->
    <delete id="deleteById">
        delete from user where id=#{id}
    </delete>


</mapper>